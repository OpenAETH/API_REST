+                  <span>{d}</span>
+                </li>
+              ))}
+            </ul>
+          </div>
+        </Reveal>
+
+        <Reveal delay={100}>
+          <div className="h-full rounded-2xl border border-line-900 bg-void-800/40 p-6 md:p-8">
+            <h3 className="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-signal-400">
+              <span className="h-1.5 w-1.5 rounded-full bg-signal-500" />
+              Lo que necesitamos de vos
+            </h3>
+            <ul className="grid gap-2">
+              {requirements.map((r) => (
+                <li key={r} className="flex items-center gap-3 border-b border-line-900/60 py-2 text-sm text-ink-300 md:text-base">
